def entregadores_pedidos(id_ent):
    orders = []                                 # cria a lista que vai guardar os ids dos pedidos escolhidos
    pedidos_livres = []                         # cria uma lista para filtrar os pedidos sem entregador
    for i in pedidos:                           # percorre a lista geral de todos os pedidos (i é o dicionario do pedido)
        if i['id_entregador'] == []:            # se o pedido nao tiver nenhum entregador associado (lista vazia):
            pedidos_livres.append(i)            # adiciona o dicionario do pedido na lista de pedidos livres
    
    if pedidos_livres == []:                    # se a lista de pedidos livres continuar vazia:
        print("Não há pedidos disponíveis.")    
        return []                               # encerra a função devolvendo uma lista vazia
    
    alta = []                                   # cria uma lista para separar pedidos de alta prioridade
    normal = []                                 # cria uma lista para separar pedidos de prioridade normal
    for i in pedidos_livres:                    # percorre a lista de pedidos que estao sem entregador
        if i['prioridade'] == 'Alta':           # i é odicionário pedido, se o índice dele for alta, adiciona na lista alta
            alta.append(i)                      # joga o dicionario do pedido na lista alta
        else:
            normal.append(i)                    # joga o dicionario do pedido na lista normal
    for i in alta + normal:                     # junta as listas mostrando os de alta prioridade primeiro
        print('ID do pedido:', i['id_pedido'])  # exibe na tela o ID de cada pedido disponivel
    
    num = int(input('Quantos pedidos deseja associar a esse entregador? ')) # recebe a quantidade de entregas desejada
    while num > 10 or num > len(pedidos_livres): # valida se a quantidade nao ultrapassa o limite ou o total disponivel
        if num > 10:
            print('Máximo de 10 pedidos por entregador')
            num = int(input('Quantos pedidos deseja associar a esse entregador? '))
        else:
            print(f'Máximo de {len(pedidos_livres)} pedidos disponíveis')
            num = int(input('Quantos pedidos deseja associar a esse entregador? '))
    i = 0                                       # inicia o contador para controlar a quantidade de escolhas
    while i < num:                              # repete o bloco ate o usuario escolher a quantidade total que pediu
        pedido = input(f'Digite o {i+1}º id: ') # recebe o ID do pedido que o usuario quer vincular
        for k in pedidos_livres:                # percorre os pedidos livres (k é o dicionario do pedido livre)
            if k['id_pedido'] == pedido:        # se o ID do pedido livre for igual ao ID que o usuario digitou:
                orders.append(pedido)           # adiciona o ID digitado na lista orders
                k['id_entregador'] = id_ent     # atualiza a chave do pedido com o ID do entregador atual
                break                           # para o loop for de busca e vai para o proximo pedido
        else:                                   # roda se o loop for terminar sem encontrar o ID (comando else do for)
            print('ID não existe ou já tem entregador')
            continue                            # pula o restante do while e pede o mesmo numero de ID novamente
        i += 1                                  # soma 1 no contador apenas se o ID digitado foi valido
    return orders                               # devolve a lista orders cheia de IDs para quem chamou a funcao

def disponibilidade(ped):
    tamanho = len(ped)
    if tamanho >= 9:
        return 'indisponível'
    return 'disponível'
               

