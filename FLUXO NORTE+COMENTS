def criar_id():
    letra = random.choice(string.ascii_letters)
    numeros = random.randint(1000, 9999)
    id = letra + str(numeros)
    repetiu = True
    while repetiu == True:
        repetiu = False
        for p in pedidos:
            if id == p['id_pedido']:
                letra = random.choice(string.ascii_letters)
                numeros = random.randint(1000, 9999)
                id = letra + str(numeros)
                repetiu = True
    print(f"o id {id} foi gerado")
    return id


